{
  "owner": {
    "name": "Alex",
    "github": "alex"
  },
  "repos": {
    "app": {
      "github": "acme/app",
      "path": "~/projects/app",
      "remote": "origin",
      "base": "main",
      "branch_prefix": "factory/",
      "setup": "pnpm install --frozen-lockfile",
      "ship": "pr",
      "ship_why": "every change goes through a PR into main; CI runs there and Alex merges",
      "principles": "principles/app.md",
      "worker_model": "opus",
      "plugins": []
    }
  },
  "targets": [
    {
      "name": "app-do-now",
      "repo": "app",
      "labels": ["priority: high"],
      "scope_rule": "Code changes an agent can build and ship under the repo's CLAUDE.md. Not: steps only Alex can do (accounts, payments, posts), anything that reopens a recorded decision. If unsure, 'later'.",
      "max_in_flight": 2,
      "max_awaiting_review": 5,
      "paused": true
    },
    {
      "name": "settings-polish",
      "repo": "app",
      "batch": 120,
      "scope_rule": "Bugs, copy and small UI polish on the existing settings pages only. No new settings, no new tables, no new integrations. If unsure, 'later'.",
      "max_in_flight": 2,
      "max_awaiting_review": 6,
      "stack": true,
      "design": "~/.claude/factory/projects/settings-polish",
      "paused": true
    }
  ],
  "workers": {
    "max_concurrent": 3,
    "model": "opus",
    "effort": "high",
    "claude_args": ["--dangerously-skip-permissions"],
    "settings": "worker-settings.json",
    "env": {},
    "lease_minutes": 180,
    "max_restarts": 2
  },
  "triage": {
    "enabled": true,
    "model": "sonnet",
    "max_per_tick": 20,
    "parallel": 4
  },
  "planner": {
    "enabled": true,
    "model": "sonnet",
    "max_package": 4
  },
  "babysit": {
    "enabled": true,
    "heartbeat_hours": 6
  },
  "notify": {
    "desktop": true
  },
  "usage": {
    "ticket_alert_percent": 3
  },
  "issues_doc": "issues.md",
  "tick": {
    "state_dir": "state",
    "lock_stale_minutes": 30,
    "sweep_agent_worktrees": false
  }
}
